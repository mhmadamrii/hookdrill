# Copy to .env for local development. Production values live on the VPS.
DATABASE_URL=postgres://USER@localhost:5432/hookdrill
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
# GitHub OAuth app; callback URL: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Production only, e.g. .hookdrill.dev, so web and api share the session cookie
COOKIE_DOMAIN=
# Read by the web app (Vite)
VITE_API_URL=http://localhost:3001
