# Copy to .env.production on the VPS (never commit).
# Existing kommers_postgres_1; URL-encode special characters in the password
DATABASE_URL=postgres://hookdrill:PASSWORD@kommers_postgres_1:5432/hookdrill
# openssl rand -base64 32
BETTER_AUTH_SECRET=
# GitHub OAuth app; callback: https://api.hookdrill.yappers.online/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public domain of the Vercel deployment (custom domain under yappers.online keeps cookies same-site)
WEB_HOST=hookdrill.yappers.online
API_HOST=api.hookdrill.yappers.online
COOKIE_DOMAIN=.hookdrill.yappers.online
# Podman network the Caddy container is attached to
CADDY_NETWORK=kommers_default
